# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.env*.local
/docs/superpowers

# tests/tickets/*.test.ts used to be ignored as per-session scratch. It stopped
# being that a long time ago — the directory is now 60+ complete suites that are
# the only coverage several features have. Ignoring them meant they lived in one
# working tree, unreviewed, and drifted red without anyone noticing.

# Playwright test output artifacts
/test-results
/playwright-report
